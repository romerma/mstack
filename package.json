{
  "name": "mstack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dev tooling for the mstack Claude Code plugin. There is no build step: src/ is what ships and what runs.",
  "scripts": {
    "test": "bun test tests/ && node --test 'tests/*.test.ts'",
    "test:bun": "bun test tests/",
    "test:node": "node --test 'tests/*.test.ts'",
    "typecheck": "bunx --bun tsc --noEmit",
    "lint": "./bin/mstack lint-plugin ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
